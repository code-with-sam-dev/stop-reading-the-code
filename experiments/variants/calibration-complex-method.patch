+    /** The processing fee, in cents, for a payment of this size. */
+    public long feeFor(long amountCents) {
+        long fee = 0;
+        if (amountCents > 1000) {
+            fee += 1;
+        }
+        if (amountCents > 2000) {
+            fee += 2;
+        }
+        if (amountCents > 3000) {
+            fee += 3;
+        }
+        if (amountCents > 4000) {
+            fee += 4;
+        }
+        if (amountCents > 5000) {
+            fee += 5;
+        }
+        if (amountCents > 6000) {
+            fee += 6;
+        }
+        if (amountCents > 7000) {
+            fee += 7;
+        }
+        if (amountCents > 8000) {
+            fee += 8;
+        }
+        if (amountCents > 9000) {
+            fee += 9;
+        }
+        return fee;
+    }
